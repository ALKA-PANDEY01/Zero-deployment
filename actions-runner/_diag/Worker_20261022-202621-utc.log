              "type": 0,
              "file": 1,
              "line": 73,
              "col": 14,
              "lit": "set -euo pipefail\n\nif [[ -z \"$ZERODOWN_URL\" || -z \"$ZERODOWN_DEPLOY_TOKEN\" ]]; then\n  echo \"Set the ZERODOWN_URL and ZERODOWN_DEPLOY_TOKEN repository secrets.\"\n  exit 1\nfi\nif [[ \"$ZERODOWN_URL\" != https://* \\\n  && \"$ZERODOWN_URL\" != http://localhost:* \\\n  && \"$ZERODOWN_URL\" != http://127.0.0.1:* ]]; then\n  echo \"Use HTTPS for remote controllers; HTTP is allowed only for localhost.\"\n  exit 1\nfi\nZERODOWN_URL=\"${ZERODOWN_URL%/}\"\n\nrequest_file=\"$(mktemp)\"\ntrap 'rm -f \"$request_file\"' EXIT\npython -c 'import json, os; print(json.dumps({\"image\": os.environ[\"IMAGE_REF\"], \"registry_username\": os.environ[\"GHCR_USERNAME\"], \"registry_token\": os.environ[\"GHCR_TOKEN\"]}))' > \"$request_file\"\n\naccepted=\"$(curl --fail --silent --show-error \\\n  --connect-timeout 10 --max-time 30 \\\n  -X POST \"$ZERODOWN_URL/api/v1/deploy\" \\\n  -H \"Authorization: ***" \\\n  -H \"Content-Type: application/json\" \\\n  --data-binary \"@$request_file\")\"\nif ! python -c 'import json, sys; data=json.load(sys.stdin); sys.exit(0 if data.get(\"accepted\") is True and isinstance(data.get(\"deployment_id\"), str) else 1)' <<< \"$accepted\"; then\n  echo \"ZeroDown did not accept the deployment request.\"\n  exit 1\nfi\n\ndeployment_id=\"$(python -c 'import json, sys; print(json.load(sys.stdin)[\"deployment_id\"])' <<< \"$accepted\")\"\necho \"ZeroDown accepted deployment $deployment_id for image $IMAGE_REF.\"\n\nfor ((attempt=1; attempt<=180; attempt++)); do\n  if status_json=\"$(curl --fail --silent --show-error \\\n    --connect-timeout 10 --max-time 20 \\\n    \"$ZERODOWN_URL/deployment/status\")\"; then\n    current_id=\"$(python -c 'import json, sys; print(json.load(sys.stdin).get(\"deployment_id\") or \"\")' <<< \"$status_json\")\"\n    phase=\"$(python -c 'import json, sys; print(json.load(sys.stdin).get(\"status\") or \"\")' <<< \"$status_json\")\"\n\n    if [[ \"$current_id\" == \"$deployment_id\" ]]; then\n      case \"$phase\" in\n        SUCCESS)\n          echo \"ZeroDown rollout completed successfully.\"\n          exit 0\n          ;;\n        ROLLBACK|FAILED)\n          echo \"ZeroDown rollout ended with phase $phase:\"\n          python -c 'import json, sys; d=json.load(sys.stdin); print(json.dumps({k:d.get(k) for k in (\"status\", \"message\", \"rollback\")}))' <<< \"$status_json\"\n          exit 1\n          ;;\n      esac\n    fi\n  fi\n  sleep 5\ndone\n\necho \"Timed out waiting for ZeroDown deployment $deployment_id.\"\nexit 1\n"
